{
  "name": "polutone",
  "version": "0.1.0",
  "private": true,
  "description": "POLUTONE online store — Next.js + Payload CMS",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "screenshot": "node scripts/screenshot.mjs",
    "sync": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/sync.ts",
    "seed:mock": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/publish-mock.ts",
    "seed:photos": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/import-photos.ts",
    "seed:info": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-info.ts",
    "vercel-build": "npm run migrate && npm run seed:build && npm run build",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "seed:build": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-build.ts",
    "cdek": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/cdek.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.0",
    "@payloadcms/email-nodemailer": "3.94.0",
    "@payloadcms/live-preview-react": "^3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/storage-s3": "3.94.0",
    "@payloadcms/storage-vercel-blob": "3.94.0",
    "@payloadcms/translations": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "puppeteer": "^25.18.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.18.1": true
  }
}
