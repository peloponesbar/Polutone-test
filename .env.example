# Скопируйте этот файл в .env и впишите свои значения.
# .env в git НЕ попадает (см. .gitignore). Этот файл — попадает, поэтому без ключей.

# --- База данных (PostgreSQL) ---
# Локально: postgres://postgres:<пароль>@localhost:5432/polutone
DATABASE_URL=
# Отдельная база для интеграционных тестов (тесты её очищают)
DATABASE_URL_TEST=

# --- Каталог ---
# mock — вымышленные товары; moysklad — настоящий МойСклад (подключается позже)
CATALOG_SOURCE=mock

# --- Payload CMS ---
# Длинная случайная строка, своя для каждого окружения
PAYLOAD_SECRET=

# --- Timeweb Cloud S3 — хранилище картинок сайта ---
# Endpoint и регион — из панели Timeweb Cloud → Хранилище S3 → ваш бакет
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1

# Имя бакета (тип бакета — публичный, чтобы картинки открывались на сайте)
S3_BUCKET=

# Ключи доступа бакета — только в .env, никогда в git
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Публичный адрес картинок: <endpoint>/<bucket>
# Пример: https://s3.twcstorage.ru/my-bucket
S3_PUBLIC_URL=

# --- МойСклад API ---
# Токен — только в .env, никогда в этом файле (он уходит в GitHub)
MOYSKLAD_TOKEN=
# --- Тестовые фото ---
# Пусто — берётся пакет из репозитория (test-data/photos). Можно указать другую папку с index.csv
PHOTO_PACK_DIR=

# --- Vercel Blob — хранилище фото тестового сайта на Vercel ---
# На Vercel добавляется само при подключении Blob. Локально не нужен (фото в папке /media)
BLOB_READ_WRITE_TOKEN=

# --- Пароль на весь сайт (для тестового адреса) ---
# Пусто — сайт открыт. Задан — браузер спросит пароль (имя пользователя любое)
SITE_PASSWORD=

# --- Тестовые данные при сборке (только тестовый сайт) ---
# true — при сборке создаются страницы «Информация» и вымышленный каталог
SEED_TEST_DATA=

# --- Уведомления о заказах в Telegram (необязательно) ---
# Токен бота — от @BotFather; только в .env, никогда в этом файле
TELEGRAM_BOT_TOKEN=
# ID чата, куда бот добавлен (группа заказов или личный чат)
TELEGRAM_CHAT_ID=

# --- Оплата: ЮKassa (yookassa.ru → Интеграция → Ключи API) ---
# Пусто — локально работает тестовая страница оплаты без денег, на сервере оплата выключена.
# Ключи — только в .env, никогда в этом файле
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ставка НДС в чеке: 1 — без НДС (ИП на УСН). Уточните у бухгалтера перед запуском
YOOKASSA_VAT_CODE=1
# Уведомления о платежах — в личном кабинете ЮKassa → HTTP-уведомления:
#   https://<адрес сайта>/api/payments/yookassa  (события payment.succeeded и payment.canceled)

# --- Адрес сайта для ссылок в письмах и возврата из ЮKassa ---
# Пусто — на Vercel берётся его адрес, локально http://localhost:3000. На своём домене: https://polutone.ru
SITE_URL=

# --- Отмена неоплаченных заказов по расписанию ---
# Длинная случайная строка. Vercel Cron передаёт её сам; на своём сервере cron вызывает
#   curl -H "Authorization: Bearer <CRON_SECRET>" https://<сайт>/api/cron/expire-orders
CRON_SECRET=

# --- Почта для писем покупателю (любой SMTP: Unisender Go, Яндекс 360…) ---
# Пусто — письма не отправляются, а пишутся в журнал сервера. Нужен свой домен (SPF/DKIM)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Адрес отправителя на вашем домене, например shop@polutone.ru
MAIL_FROM=
MAIL_FROM_NAME=POLUTONE

# --- Доставка СДЭК (личный кабинет СДЭК → Интеграция) ---
# Пусто — локально работает тестовая доставка (вымышленные города и пункты), на сервере расчёт выключен.
# Ключи — только в .env, никогда в этом файле
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# true — тестовое окружение СДЭК (api.edu.cdek.ru) с тестовыми ключами из их документации
CDEK_TEST=
# Город отправки и пункт сдачи задаются в админке: «Настройки сайта» → «Доставка».
# Коды: npm run cdek -- find "Красная Поляна"
# Уведомления о статусах: npm run cdek -- webhook https://<сайт>/api/delivery/cdek

# --- Яндекс Карты на выборе пункта выдачи (developer.tech.yandex.ru → JavaScript API) ---
# Ключ виден в браузере — в кабинете Яндекса ограничьте его адресами сайта. Пусто — только список пунктов
NEXT_PUBLIC_YANDEX_MAPS_KEY=
