# Скопируйте этот файл в .env и впишите свои значения.
# .env в git НЕ попадает (см. .gitignore). Этот файл — попадает, поэтому без ключей.

# --- База данных (PostgreSQL) ---
# Локально: postgres://postgres:<пароль>@localhost:5432/polutone
DATABASE_URL=
# Отдельная база для интеграционных тестов (тесты её очищают)
DATABASE_URL_TEST=

# --- Каталог ---
# mock — вымышленные товары; moysklad — настоящий МойСклад (подключается позже)
CATALOG_SOURCE=mock

# --- Payload CMS ---
# Длинная случайная строка, своя для каждого окружения
PAYLOAD_SECRET=

# --- Timeweb Cloud S3 — хранилище картинок сайта ---
# Endpoint и регион — из панели Timeweb Cloud → Хранилище S3 → ваш бакет
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1

# Имя бакета (тип бакета — публичный, чтобы картинки открывались на сайте)
S3_BUCKET=

# Ключи доступа бакета — только в .env, никогда в git
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Публичный адрес картинок: <endpoint>/<bucket>
# Пример: https://s3.twcstorage.ru/my-bucket
S3_PUBLIC_URL=

# --- МойСклад API ---
# Токен — только в .env, никогда в этом файле (он уходит в GitHub)
MOYSKLAD_TOKEN=
# --- Тестовые фото ---
# Пусто — берётся пакет из репозитория (test-data/photos). Можно указать другую папку с index.csv
PHOTO_PACK_DIR=

# --- Vercel Blob — хранилище фото тестового сайта на Vercel ---
# На Vercel добавляется само при подключении Blob. Локально не нужен (фото в папке /media)
BLOB_READ_WRITE_TOKEN=

# --- Пароль на весь сайт (для тестового адреса) ---
# Пусто — сайт открыт. Задан — браузер спросит пароль (имя пользователя любое)
SITE_PASSWORD=

# --- Тестовые данные при сборке (только тестовый сайт) ---
# true — при сборке создаются страницы «Информация» и вымышленный каталог
SEED_TEST_DATA=

# --- Уведомления о заказах в Telegram (необязательно) ---
# Токен бота — от @BotFather; только в .env, никогда в этом файле
TELEGRAM_BOT_TOKEN=
# ID чата, куда бот добавлен (группа заказов или личный чат)
TELEGRAM_CHAT_ID=
