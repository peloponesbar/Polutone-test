# Timeweb Cloud S3 — хранилище картинок сайта
# Скопируйте этот файл в .env и впишите свои значения.
# .env в git НЕ попадает (см. .gitignore). Этот файл — попадает, поэтому без ключей.

# Endpoint и регион — из панели Timeweb Cloud → Хранилище S3 → ваш бакет
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1

# Имя бакета (тип бакета — публичный, чтобы картинки открывались на сайте)
S3_BUCKET=

# Ключи доступа бакета — только в .env, никогда в git
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Публичный адрес картинок: <endpoint>/<bucket>
# Пример: https://s3.twcstorage.ru/my-bucket
S3_PUBLIC_URL=
